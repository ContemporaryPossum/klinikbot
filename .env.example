CLINIC=demo-dental
PORT=3000
DATA_DIR=./data
# Meta WhatsApp Cloud API — leave blank for demo mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Claude answers free-text questions — leave blank to run script-only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Approved template names in Meta (needed so reminders can be sent >24h after the patient's last message)
WHATSAPP_TEMPLATE_REMINDER_24H=appt_reminder_24h
WHATSAPP_TEMPLATE_REMINDER_2H=appt_reminder_2h
